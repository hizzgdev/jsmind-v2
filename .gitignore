.DS_Store
node_modules/
coverage
dist/
logs/
_site/
.vscode/settings.json

# vim / editor swap & undo files (never commit these — they can carry file contents)
*.swp
*.swo
*.swn



# agent scratch space (experiments, screenshots, probes)
/tmp/

# 含凭证的本机约定，切勿提交
/AGENTS.local.md

# VitePress cache and default build output
docs/.vitepress/cache/
docs/.vitepress/dist/

# weka webhook 真实配置（含 secret），仓库里只保留 config.example.json
/team/automations/weka/config.json

# weka 自动化的 worktree 工作区（Cody/Reed 的隔离目录，带独立 .git），勿提交
/.worktrees/

# Python 字节码（webhook 脚本本地跑过就会有）
__pycache__/
*.pyc
