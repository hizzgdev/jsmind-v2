#!/bin/sh

# Git pre-push hook receives:
# - Command line args: <remote> <url>
# - stdin: lines of <local_ref> <local_sha> <remote_ref> <remote_sha>
# Collect every ref line git wants to update.
# git invokes this hook even when the remote is already up to date, in which
# case it provides no input at all. Empty input is handled further down -- and
# it is *verified* against the remote-tracking ref rather than assumed.
PUSH_REFS=""
PUSH_COUNT=0
while read -r local_ref local_sha remote_ref remote_sha; do
    PUSH_COUNT=$((PUSH_COUNT + 1))
    PUSH_REFS="${PUSH_REFS}${local_ref} ${local_sha} ${remote_ref} ${remote_sha}
"
done

if [ "$PUSH_COUNT" -eq 0 ]; then
    CURRENT_BRANCH=$(git symbolic-ref --short -q HEAD 2>/dev/null)

    if [ -z "$CURRENT_BRANCH" ]; then
        echo "[pre-push] Detached HEAD and no refs on stdin."
        echo "[pre-push] Cannot determine what is being pushed; running checks to be safe."
    else
        LOCAL_SHA=$(git rev-parse HEAD 2>/dev/null)
        TRACKING_SHA=$(git rev-parse --verify --quiet "refs/remotes/origin/${CURRENT_BRANCH}" 2>/dev/null)

        if [ -n "$TRACKING_SHA" ] && [ "$LOCAL_SHA" = "$TRACKING_SHA" ]; then
            echo "[pre-push] Nothing to push: ${CURRENT_BRANCH} matches origin/${CURRENT_BRANCH}."
            exit 0
        fi

        if [ -z "$TRACKING_SHA" ]; then
            # No remote-tracking ref (shallow clone, or branch never fetched).
            # git calling pre-push with zero refs still means "nothing to update",
            # but we cannot verify it locally -- say so instead of guessing silently.
            echo "[pre-push] No refs on stdin and no local ref for origin/${CURRENT_BRANCH}."
            echo "[pre-push] Nothing appears to be pushed; skipping checks."
            exit 0
        fi

        # Tracking ref exists but differs: stdin should not have been empty.
        echo "[pre-push] WARNING: no refs on stdin, but ${CURRENT_BRANCH} (${LOCAL_SHA})"
        echo "[pre-push]          differs from origin/${CURRENT_BRANCH} (${TRACKING_SHA})."
        echo "[pre-push] Running checks to be safe."
        # Feed HEAD into the check pipeline below so the checks actually run.
        local_ref="refs/heads/${CURRENT_BRANCH}"
        local_sha="$LOCAL_SHA"
        remote_ref="refs/heads/${CURRENT_BRANCH}"
        remote_sha="$TRACKING_SHA"
    fi
else
    read -r local_ref local_sha remote_ref remote_sha <<EOF
$(printf '%s' "$PUSH_REFS" | head -1)
EOF
fi

if [ -z "$local_sha" ]; then
    echo "[pre-push] No commit SHA available, skipping checks."
    exit 0
fi

# Check if this is a branch deletion operation
# When deleting a branch, local_ref is "(delete)" and local_sha is all zeros
if [ "$local_ref" = "(delete)" ] || [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    echo "Skipping pre-push checks for branch deletion..."
    exit 0
fi

# Generate a unique status file based on the commit SHA being pushed
STATUS_FILE="logs/pre-push/check-status-${local_sha}"

# Create logs directory if it doesn't exist
mkdir -p logs/pre-push

# Check if status file exists
if [ -f "$STATUS_FILE" ]; then
    # Status file exists, check if it contains success flag
    if grep -q "^PRE_PUSH_SUCCESS$" "$STATUS_FILE"; then
        echo "✅ Pre-push checks already passed for commit ${local_sha}"
        echo "📄 Check detailed output in: $STATUS_FILE"
        exit 0
    else
        # Status file exists but no PRE_PUSH_SUCCESS flag, means previous check failed
        echo "❌ Pre-push checks failed for commit ${local_sha}"
        echo "📄 Check detailed output in: $STATUS_FILE"
        exit 1
    fi
fi

# Status file doesn't exist, run all checks
echo "[pre-push] Running checks for commit ${local_sha}..."

# Record start time
START_TIME=$(date +%s)
START_TIME_STR=$(date '+%Y-%m-%d %H:%M:%S')
echo "[pre-push] Start time: ${START_TIME_STR}" > "$STATUS_FILE"
echo "[pre-push] Running checks for commit ${local_sha}..." >> "$STATUS_FILE"
echo "" >> "$STATUS_FILE"

# Helper function to record end time
record_end_time() {
    END_TIME=$(date +%s)
    END_TIME_STR=$(date '+%Y-%m-%d %H:%M:%S')
    ELAPSED=$((END_TIME - START_TIME))
    {
        echo ""
        echo "---"
        echo "[pre-push] End time: ${END_TIME_STR}"
        echo "[pre-push] Total elapsed time: ${ELAPSED} seconds"
    } >> "$STATUS_FILE"
}

# Run format-check
echo "[pre-push] Running format-check..."
echo "[pre-push] Running format-check..." >> "$STATUS_FILE"
npm run format-check >> "$STATUS_FILE" 2>&1
if [ $? -ne 0 ]; then
    record_end_time
    echo "❌ format-check failed. Check detailed output in: $STATUS_FILE"
    exit 1
fi

# Run type-check
echo "[pre-push] Running type-check..."
echo "" >> "$STATUS_FILE"
echo "[pre-push] Running type-check..." >> "$STATUS_FILE"
npm run type-check >> "$STATUS_FILE" 2>&1
if [ $? -ne 0 ]; then
    record_end_time
    echo "❌ type-check failed. Check detailed output in: $STATUS_FILE"
    exit 1
fi

# Run test
echo "[pre-push] Running test..."
echo "" >> "$STATUS_FILE"
echo "[pre-push] Running test..." >> "$STATUS_FILE"
npm run test >> "$STATUS_FILE" 2>&1
if [ $? -ne 0 ]; then
    record_end_time
    echo "❌ test failed. Check detailed output in: $STATUS_FILE"
    exit 1
fi

# All checks passed, record end time and add success flag to status file
record_end_time
echo "PRE_PUSH_SUCCESS" >> "$STATUS_FILE"

echo "✅ All pre-push checks passed!"
echo "📄 Check detailed output in: $STATUS_FILE"
exit 0
