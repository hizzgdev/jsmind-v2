{
    "name": "jsmind",
    "version": "2.0.0",
    "description": "Version 2 of jsMind, which is a TypeScript library for mindmap.",
    "type": "module",
    "main": "dist/jsmind.js",
    "types": "dist/jsmind.d.ts",
    "bin": {
        "jsmind": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "import": "./dist/jsmind.js",
            "require": "./dist/jsmind.js",
            "types": "./dist/jsmind.d.ts"
        }
    },
    "files": [
        "dist/cli.js",
        "dist/cli.js.map",
        "dist/jsmind.js",
        "dist/jsmind.js.map",
        "dist/jsmind.d.ts"
    ],
    "scripts": {
        "server": "http-server",
        "build": "rollup -c .config/rollup.config.js",
        "test": "node --test \"__tests__/!(ui)/**/*.test.ts\"",
        "test-lite": "node --test --test-reporter=dot \"__tests__/!(ui)/**/*.test.ts\"",
        "format": "eslint --fix --config .config/eslint.config.js",
        "format-check": "eslint --config .config/eslint.config.js",
        "type-check": "tsc --noEmit -p tsconfig.json",
        "compile": "tsc --help",
        "ci": "npm run format-check && npm run type-check && npm run test-lite && npm run build",
        "ci2": "npm run format-check && npm run type-check && npm run test-lite",
        "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=85 --test-coverage-exclude='tmp/**' --test-coverage-exclude='dist/**' --test-coverage-exclude='src/cli/browser.ts' --test-coverage-exclude='src/view/export.ts' \"__tests__/!(ui)/**/*.test.ts\"",
        "test:ui": "node --test \"__tests__/ui/**/*.test.ts\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hizzgdev/jsmind-v2.git"
    },
    "author": {
        "name": "hizzgdev@163.com"
    },
    "license": "BSD-3-Clause",
    "bugs": {
        "url": "https://github.com/hizzgdev/jsmind-v2/issues"
    },
    "homepage": "https://github.com/hizzgdev/jsmind-v2#readme",
    "keywords": [
        "jsmind",
        "mindmap"
    ],
    "maintainers": [
        {
            "name": "hizzgdev",
            "email": "hizzgdev@163.com"
        }
    ],
    "devDependencies": {
        "@eslint/css": "^0.14.1",
        "@eslint/js": "^9.39.2",
        "@eslint/json": "^0.14.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@stylistic/eslint-plugin": "^5.7.0",
        "@types/jsdom": "^27.0.0",
        "@types/node": "^25.0.5",
        "@typescript-eslint/eslint-plugin": "^8.52.0",
        "@typescript-eslint/parser": "^8.52.0",
        "eslint": "^9.39.2",
        "jsdom": "^27.4.0",
        "rollup": "^4.55.1",
        "rollup-plugin-dts": "^6.3.0",
        "tslib": "^2.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.52.0"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
